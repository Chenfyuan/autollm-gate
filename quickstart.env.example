# 本地体验用配置。推荐运行 sh scripts/gen-env.sh 自动生成带随机密钥的 .env；
# 手动复制时，请把下面所有 CHANGE_ME 换成自己的随机字符串（ROUTER_MASTER_KEY 必须是 Fernet 密钥，见下方命令）。
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ROUTER_MASTER_KEY=CHANGE_ME
SESSION_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
# 首个管理员账号（只在第一次启动时创建）
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

ENV=production
# 本地用 http://localhost 访问，必须为 0 才能登录；上服务器走 HTTPS 后改回 1
COOKIE_SECURE=0
ENABLE_MOCK_PAYMENT=0
ALLOW_SIGNUP=1
SIGNUP_CREDIT_USD=0
PLATFORM_MARKUP_PCT=8
LOG_FORMAT=json
REPORT_TZ=Asia/Shanghai

# 本地体验：把 OpenAI 通道指向假上游（不发真实请求）。要接真实 OpenAI 时，删掉这一行并重启。
OPENAI_BASE_URL=http://mock-upstream:9000/v1

# 端口被占用时改这里，例如 18080
GATE_PORT=8080
