# ===== 必填 =====
# Fernet 主密钥，用于加密存储上游 Key：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ROUTER_MASTER_KEY=CHANGE_ME
# 会话签名密钥（≥32 位随机串）：python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
# 首个管理员（仅在库里还没有管理员时创建一次；之后可在后台「管理员」页添加更多账号、修改密码）
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

# 运行环境：production 时做安全检查（禁止模拟支付、必须配置 SESSION_SECRET、Cookie 仅 HTTPS）
ENV=production
# single = 单实例；ha = 2 副本 + nginx；可追加 ,monitoring 启动 Prometheus
COMPOSE_PROFILES=single
# 本地 http 调试时可设为 0；生产务必走 HTTPS 并保持 1
# COOKIE_SECURE=1

# ===== 计费 =====
PLATFORM_MARKUP_PCT=8
BYOK_FEE_PER_REQUEST_USD=0
BYOK_FEE_PER_1K_TOKENS_USD=0
# 未指定 max_tokens 时按此输出 token 数预授权冻结余额
RESERVE_DEFAULT_OUTPUT_TOKENS=4096
# 开发调试用模拟支付渠道，生产必须为 0（否则拒绝启动）
ENABLE_MOCK_PAYMENT=0
# 是否允许自助注册 / 新用户赠送额度（美元）
ALLOW_SIGNUP=1
SIGNUP_CREDIT_USD=0

# ===== 限流 =====
DEFAULT_KEY_RPM=600
LOGIN_RATE_PER_MIN=20
SIGNUP_RATE_PER_HOUR=5

# ===== 稳定性 =====
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=15
UPSTREAM_TIMEOUT_SECONDS=600
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
ALERT_INTERVAL_SECONDS=30
# /metrics 访问令牌（可选；设置后 Prometheus 需带 Authorization: Bearer）
# METRICS_TOKEN=
LOG_FORMAT=json
REPORT_TZ=Asia/Shanghai

# ===== 上游地址（可选，默认官方地址；可指向企业代理）=====
SELFHOSTED_BASE_URL=http://vllm:8000/v1
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# DEEPSEEK_BASE_URL=
# GEMINI_BASE_URL=

# ===== 仅「纯开源内核」单租户模式使用（APP=autollm_gate.main:app）=====
# ROUTER_API_KEY=CHANGE_ME
# OPENAI_API_KEY=
